@prefix : <https://ontology.inscriptiones.org/epont/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix epont: <https://ontology.inscriptiones.org/epont/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix crmtex: <http://www.cidoc-crm.org/extensions/crmtex/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://ontology.inscriptiones.org/epont/> .

<https://ontology.inscriptiones.org/epont/> rdf:type owl:Ontology ;
                                             rdfs:comment "An ontology for epigraphic data, reusing CIDOC-CRM, CRMtex, CRMsci, LRMoo, and Dublin Core Terms."@en ;
                                             skos:prefLabel "FAIR Epigraphy Ontology (epont)"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty ;
                rdfs:range dcterms:BibliographicResource ;
                rdfs:domain <https://cidoc-crm.org//extensions/lrmooF3_Manifestation> .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://cidoc-crm.org/cidoc-crm/7.1.2/P165_incorporates
<http://cidoc-crm.org/cidoc-crm/7.1.2/P165_incorporates> rdf:type owl:ObjectProperty ;
                                                         skos:definition ""@en ;
                                                         skos:prefLabel "P165 incorporates"@en ;
                                                         skos:scopeNote """This property associates an instance of E73 Information Object with an instance of E90 Symbolic Object (or any of its subclasses) that was included in it.

This property makes it possible to recognise the autonomous status of the incorporated signs, which were created in a distinct context, and can be incorporated in many instances of E73 Information Object, and to highlight the difference between structural and accidental whole-part relationships between conceptual entities.

It accounts for many cultural facts that are quite frequent and significant: the inclusion of a poem in an anthology, the re-use of an operatic aria in a new opera, the use of a reproduction of a painting for a book cover or a CD booklet, the integration of textual quotations, the presence of lyrics in a song that sets those lyrics to music, the presence of the text of a play in a movie based on that play, etc.

In particular, this property allows for modelling relationships of different levels of symbolic specificity, such as the natural language words making up a particular text, the characters making up the words and punctuation, the choice of fonts and page layout for the characters.

When restricted to information objects, that is, seen as a property with E73 Information Object as domain and range the property is transitive.

A digital photograph of a manuscript page incorporates the text of a manuscript page, if the respective text is defined as a sequence of symbols of a particular type, such as Latin characters, and the resolution and quality of the digital image is sufficient to resolve these symbols so they are readable on the digital image.

This property is asymmetric."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P11_had_participant
<http://cidoc-crm.org/cidoc-crm/7.1.3/P11_had_participant> rdf:type owl:ObjectProperty ;
                                                           owl:inverseOf crm:P11i_participated_in ;
                                                           rdfs:domain <https://cidoc-crm.org/extensions/crmsci/html/CRMsci_v2.0.html#S19> ;
                                                           rdfs:range <https://www.cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E39> ;
                                                           rdfs:comment "Inverse: participated in"@en ;
                                                           skos:definition ""@en ;
                                                           skos:prefLabel "P11 had participant"@en ;
                                                           skos:scopeNote """This property describes the active or passive participation of instances of E39 Actors in an instance of E5 Event.

It documents known events in which an instance of E39 Actor has participated during the course of that actor’s life or history. The instances of E53 Place and E52 Time-Span where and when these events happened provide constraints about the presence of the related instances of E39 Actor in the past. Collective actors, i.e. instances of E74 Group, may physically participate in events via their representing instances of E21 Persons only. The participation of multiple actors in an event is most likely an indication of their acquaintance and interaction.

The property implies that the actor was involved in the event but does not imply any causal relationship. For instance, someone having been portrayed can be said to have participated in the creation of the portrait."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P138_represents
<http://cidoc-crm.org/cidoc-crm/7.1.3/P138_represents> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf crm:P138i_has_representation ;
                                                       rdfs:domain <http://cidoc-crm.org/cidoc-crm/7.1.3/E36_Visual_Item> ,
                                                                   <http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TX10_Style> ,
                                                                   epont:Allograph ,
                                                                   epont:Character ,
                                                                   epont:Idiograph ;
                                                       rdfs:range crm:E24_Physical_Human-Made_Thing ,
                                                                  <http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TX13_Script> ,
                                                                  epont:Allograph ,
                                                                  epont:Character ,
                                                                  epont:Inscribed_Text ,
                                                                  epont:Ontograph ;
                                                       rdfs:comment "Inverse: has representation"@en ;
                                                       skos:definition ""@en ;
                                                       skos:prefLabel "P138 represents"@en ;
                                                       skos:scopeNote """This property establishes the relationship between an instance of E36 Visual Item and the instance of E1 CRM Entity that it visually represents.

Any entity may be represented visually. This property is part of the fully developed path from E24 Physical Human-Made Thing through P65 shows visual item (is shown by), E36 Visual Item, P138 represents (has representation) to E1 CRM Entity, which is shortcut by P62 depicts (is depicted by). P138.1 mode of representation allows the nature of the representation to be refined.

This property is also used for the relationship between an original and a digitisation of the original by the use of techniques such as digital photography, flatbed or infrared scanning. Digitisation is here seen as a process with a mechanical, causal component rendering the spatial distribution of structural and optical properties of the original and does not necessarily include any visual similarity identifiable by human observation."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P148_has_component
<http://cidoc-crm.org/cidoc-crm/7.1.3/P148_has_component> rdf:type owl:ObjectProperty ;
                                                          owl:inverseOf crm:P148i_is_component_of ;
                                                          rdfs:domain <http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TX10_Style> ;
                                                          rdfs:range epont:Allograph ;
                                                          rdfs:comment "Inverse: is component of"@en ;
                                                          skos:definition ""@en ;
                                                          skos:prefLabel "P148 has component"@en ;
                                                          skos:scopeNote """This property associates an instance of E89 Propositional Object with a structural part of it that is by itself an instance of E89 Propositional Object.

This property is transitive. This property is asymmetric."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P15_was_influenced_by
<http://cidoc-crm.org/cidoc-crm/7.1.3/P15_was_influenced_by> rdf:type owl:ObjectProperty ;
                                                             owl:inverseOf crm:P15i_influenced ;
                                                             rdfs:domain epont:Editing ;
                                                             rdfs:range <http://cidoc-crm.org/cidoc-crm/7.1.3/E36_Visual_Item> ,
                                                                        crm:E24_Physical_Human-Made_Thing ,
                                                                        epont:Autopsy ,
                                                                        epont:Edition ,
                                                                        epont:Transcription ;
                                                             rdfs:comment "Inverse: influenced"@en ;
                                                             skos:definition ""@en ;
                                                             skos:prefLabel "P15 was influenced by"@en ;
                                                             skos:scopeNote """This is a high-level property, which captures the relationship between an instance of E7 Activity and anything, that is, an instance of E1 CRM Entity that may have had some bearing upon it.

The property has more specific sub properties."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P32_used_general_technique
<http://cidoc-crm.org/cidoc-crm/7.1.3/P32_used_general_technique> rdf:type owl:ObjectProperty ;
                                                                  owl:inverseOf crm:P32i_was_technique_of ;
                                                                  rdfs:domain crm:E12_Production ,
                                                                              <http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TX2_Writing> ;
                                                                  rdfs:range <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E55> ,
                                                                             <https://ontology.inscriptiones.org/execution_technique> ;
                                                                  rdfs:comment "Inverse: was technique of"@en ;
                                                                  skos:definition ""@en ;
                                                                  skos:prefLabel "P32 used general technique"@en ;
                                                                  skos:scopeNote """This property identifies the technique or method, modelled as an instance of E55 Type, that was employed in an instance of E7 Activity.

These techniques should be drawn from an external E55 Type hierarchy of consistent terminology of general techniques or methods such as embroidery, oil-painting, carbon dating, etc. Specific documented techniques should be described as instances of E29 Design or Procedure.

[in the case of epigraphy a dedicated vocabulary such as https://ontology.inscriptiones.org/execution_technique might be employed]"""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P41_classified
<http://cidoc-crm.org/cidoc-crm/7.1.3/P41_classified> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#P140> ;
                                                      rdfs:domain <http://cidoc-crm.org/cidoc-crm/7.1.3/E17_Type_Assignment> ;
                                                      rdfs:comment "Inverse: was classified by" ;
                                                      skos:definition ""@en ;
                                                      skos:prefLabel "P41 classified"@en ;
                                                      skos:scopeNote """This property records the item to which a type was assigned in an E17 Type Assignment activity.

Any instance of a CIDOC CRM entity may be assigned a type through type assignment. Type assignment events allow a more detailed path from E1 CRM Entity through P41i was classified by, E17 Type Assignment, P42 assigned, to E55 Type for assigning types to objects compared to the shortcut offered by P2 has type (is type of)."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P42_assigned
<http://cidoc-crm.org/cidoc-crm/7.1.3/P42_assigned> rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#P141> ;
                                                    rdfs:domain <http://cidoc-crm.org/cidoc-crm/7.1.3/E17_Type_Assignment> ;
                                                    rdfs:range <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E55> ;
                                                    rdfs:comment "Inverse: was assigned by" ;
                                                    skos:definition ""@en ;
                                                    skos:prefLabel "P42 assigned"@en ;
                                                    skos:scopeNote """This property records the type that was assigned to an entity by an E17 Type Assignment activity.

Type assignment events allow a more detailed path from E1 CRM Entity through P41i was classified by, E17 Type Assignment, P42 assigned, to E55 Type for assigning types to objects compared to the shortcut offered by P2 has type (is type of).

For example, a fragment of an antique vessel could be assigned the type “attic red figured belly handled amphora” by expert A. The same fragment could be assigned the type “shoulder handled amphora” by expert B.

A Type may be intellectually constructed independent from assigning an instance of it."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P72_has_language
<http://cidoc-crm.org/cidoc-crm/7.1.3/P72_has_language> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E34> ,
                                                                    epont:Translation ;
                                                        rdfs:range <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E56> ;
                                                        rdfs:comment "Inverse: is language of" ;
                                                        skos:definition ""@en ;
                                                        skos:prefLabel "P72 has language" ;
                                                        skos:scopeNote """This property associates an instance(s) of E33 Linguistic Object with an instance of E56 Language in which it is, at least partially, expressed.

Linguistic Objects are composed in one or more human languages. This property allows these languages to be documented."""^^xsd:string .


###  http://cidoc-crm.org/cidoc-crm/7.1.3/P73_has_translation
<http://cidoc-crm.org/cidoc-crm/7.1.3/P73_has_translation> rdf:type owl:ObjectProperty ;
                                                           owl:inverseOf crm:P73i_is_translation_of ;
                                                           rdfs:domain <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E34> ,
                                                                       epont:Edition ,
                                                                       epont:Inscription ;
                                                           rdfs:range epont:Translation ;
                                                           rdfs:comment "Inverse: is translation of"@en ;
                                                           skos:definition ""@en ;
                                                           skos:prefLabel "P73 has translation"@en ;
                                                           skos:scopeNote """This property links an instance of E33 Linguistic Object (A), to another instance of E33 Linguistic Object (B) which is the translation of A. [and so likewise for an E34 Inscription, a subclass of E33]

When an instance of E33 Linguistic Object is translated into a new language a new instance of E33 Linguistic Object is created, despite the translation being conceptually similar to the source. [and so also a new F2 Expression]

This property is asymmetric."""^^xsd:string .


###  http://iflastandards.info/ns/lrm/lrmoo/R17i_was_created_by
lrmoo:R17i_was_created_by rdf:type owl:ObjectProperty ;
                          owl:inverseOf <https://cidoc-crm.org/extensions/lrmoo/html/LRMoo_v1.1.1.html#R17> ;
                          skos:definition "" ;
                          skos:prefLabel "R17i was created by"@en .


###  http://iflastandards.info/ns/lrm/lrmoo/R4i_is_embodied_in
lrmoo:R4i_is_embodied_in rdf:type owl:ObjectProperty ;
                         owl:inverseOf <https://cidoc-crm.org/extensions/lrmoo/html/LRMoo_v1.1.1.html#R4> ;
                         rdfs:domain <https://cidoc-crm.org/extensions/lrmoo/html/LRMoo_v1.1.1.html#F2> ,
                                     epont:Edition ,
                                     epont:Translation ;
                         rdfs:range <https://cidoc-crm.org//extensions/lrmooF3_Manifestation> ;
                         skos:definition ""@en ;
                         skos:prefLabel "R4i is embodied in"@en .


###  http://iflastandards.info/ns/lrm/lrmoo/R76i_has_derivative
lrmoo:R76i_has_derivative rdf:type owl:ObjectProperty ;
                          owl:inverseOf <https://cidoc-crm.org/extensions/lrmoo/html/LRMoo_v1.1.1.html#R76> ;
                          skos:definition ""@en ;
                          skos:prefLabel "has derivative"@en .


###  http://iflastandards.info/ns/lrm/lrmoo/R7i_is_exemplified_by
lrmoo:R7i_is_exemplified_by rdf:type owl:ObjectProperty ;
                            owl:inverseOf <https://cidoc-crm.org/extensions/lrmoo/html/LRMoo_v1.1.1.html#R7> ;
                            rdfs:domain <https://cidoc-crm.org//extensions/lrmooF3_Manifestation> ;
                            rdfs:range epont:Transcription ;
                            rdfs:comment "Inverse: exemplifies"@en ;
                            skos:definition ""@en ;
                            skos:prefLabel "R7i exemplified by"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P108_has_produced
crm:P108_has_produced rdf:type owl:ObjectProperty ;
                      owl:inverseOf crm:P108i_was_produced_by ;
                      rdfs:domain crm:E12_Production ,
                                  epont:Transcribing ;
                      rdfs:range <http://cidoc-crm.org/cidoc-crm/7.1.3/E36_Visual_Item> ,
                                 crm:E24_Physical_Human-Made_Thing ,
                                 epont:Transcription ;
                      rdfs:comment "Inverse: was produced by"@en ;
                      skos:definition ""@en ;
                      skos:prefLabel "P108 has produced"@en ;
                      skos:scopeNote """This property identifies the instance of E24 Physical Human-Made Thing that came into existence as a result of the instance of E12 Production.

The identity of an instance of E24 Physical Human-Made Thing is not defined by its matter, but by its existence as a subject of documentation. An E12 Production can result in the creation of multiple instances of E24 Physical Human-Made Thing."""^^xsd:string .


###  http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by
crm:P108i_was_produced_by rdf:type owl:ObjectProperty ;
                          rdfs:range <https://cidoc-crm.org//extensions/lrmooF3_Manifestation> ;
                          skos:definition ""@en ;
                          skos:prefLabel "P108i was produced by"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P11i_participated_in
crm:P11i_participated_in rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         skos:definition "" ;
                         skos:prefLabel "P11i participated in"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P128i_is_carried_by
crm:P128i_is_carried_by rdf:type owl:ObjectProperty ;
                        owl:inverseOf <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#P128> ;
                        rdfs:domain epont:Inscription ;
                        rdfs:range epont:Inscribed_Text ;
                        skos:definition ""@en ;
                        skos:prefLabel "P128i is carried by" .


###  http://www.cidoc-crm.org/cidoc-crm/P12_occurred_in_the_presence_of
crm:P12_occurred_in_the_presence_of rdf:type owl:ObjectProperty ;
                                    owl:inverseOf crm:P12i_was_present_at ;
                                    rdfs:domain crm:E12_Production ;
                                    rdfs:range epont:Inscribed_Text ;
                                    rdfs:comment "Inverse: was present at"@en ;
                                    skos:definition ""@en ;
                                    skos:prefLabel "P12 occurred in the presence of"@en ;
                                    skos:scopeNote """This property describes the active or passive presence of an E77 Persistent Item in an instance of E5 Event without implying any specific role.

It documents known events in which an instance of E77 Persistent Item was present during the course of its life or history. For example, an object may be the desk, now in a museum, on which a treaty was signed. The instance of E53 Place and the instance of E52 Time-Span where and when these events happened provide constraints about the presence of the related instance E77 Persistent Item in the past. Instances of E90 Symbolic Object, in particular information objects, are physically present in events via at least one of the instances of E18 Physical Thing carrying them. Note, that the human mind can be such a carrier. A precondition for a transfer of information to a person or another new physical carrier is the presence of the respective information object and this person or physical thing in one event."""^^xsd:string .


###  http://www.cidoc-crm.org/cidoc-crm/P12i_was_present_at
crm:P12i_was_present_at rdf:type owl:ObjectProperty ;
                        skos:definition "" ;
                        skos:prefLabel "P12i was present at"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P130_shows_features_of
crm:P130_shows_features_of rdf:type owl:ObjectProperty ;
                           rdfs:domain crm:E24_Physical_Human-Made_Thing ;
                           rdfs:range epont:Inscribed_Text ;
                           rdfs:comment "Inverse: features are also found on"@en ;
                           skos:definition ""@en ;
                           skos:prefLabel "P130 shows features of"@en ;
                           skos:scopeNote """This property generalises the notions of “copy of” and “similar to” into a directed relationship, where the domain expresses the derivative or influenced item and the range the source or influencing item, if such a direction can be established. The property can also be used to express similarity in cases that can be stated between two objects only, without historical knowledge about its reasons. The property expresses a symmetric relationship in case no direction of influence can be established either from evidence on the item itself or from historical knowledge. This holds in particular for siblings of a derivation process from a common source or non-causal cultural parallels, such as some weaving patterns.

The P130.1 kind of similarity property of the P130 shows features of (features are also found on) property enables the relationship between the domain and the range to be further clarified, in the sense from domain to range, if applicable. For example, it may be expressed if both items are product “of the same mould”, or if two texts “contain identical paragraphs”.

If the reason for similarity is a sort of derivation process, i.e. that the creator has used or had in mind the form of a particular thing during the creation or production, this process should be explicitly modelled. In these cases, P130 shows features of can be regarded as a shortcut of such a process. However, the current model does not contain any path specific enough to infer this property. Specializations of the CIDOC CRM may however be more explicit, for instance describing the use of moulds etc.

This property is not transitive. This property is irreflexive."""^^xsd:string .


###  http://www.cidoc-crm.org/cidoc-crm/P130i_features_are_also_found_on
crm:P130i_features_are_also_found_on rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf crm:P130_shows_features_of ;
                                     rdfs:domain crm:E24_Physical_Human-Made_Thing ;
                                     rdfs:range epont:Reproduction_Type ;
                                     skos:definition ""@en ;
                                     skos:prefLabel "P130.1 kind of similarity"@en ;
                                     skos:scopeNote "The P130.1 kind of similarity property of the P130 shows features of (features are also found on) property enables the relationship between the domain and the range to be further clarified, in the sense from domain to range, if applicable. For example, it may be expressed if both items are product “of the same mould”, or if two texts “contain identical paragraphs”."^^xsd:string .


###  http://www.cidoc-crm.org/cidoc-crm/P138_represents
crm:P138_represents rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://cidoc-crm.org/cidoc-crm/7.1.3/P138_represents> ;
                    rdfs:domain <http://cidoc-crm.org/cidoc-crm/7.1.3/E36_Visual_Item> ;
                    rdfs:range <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#E55> ;
                    skos:definition ""@en ;
                    skos:prefLabel "P138.1 mode of representation"@en ;
                    skos:scopeNote "P138.1 mode of representation allows the nature of the representation to be refined (e.g. digitisation)."^^xsd:string .


###  http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation
crm:P138i_has_representation rdf:type owl:ObjectProperty ;
                             skos:definition "" ;
                             skos:prefLabel "P138i has representation"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P140i_was_attributed_by
crm:P140i_was_attributed_by rdf:type owl:ObjectProperty ;
                            owl:inverseOf <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#P140> ;
                            skos:definition "" ;
                            skos:prefLabel "P140i was attributed by"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P141i_was_assigned_by
crm:P141i_was_assigned_by rdf:type owl:ObjectProperty ;
                          owl:inverseOf <https://cidoc-crm.org/html/cidoc_crm_v7.1.3.html#P141> ;
                          skos:definition "" ;
                          skos:prefLabel "P141i was assigned by"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P148i_is_component_of
crm:P148i_is_component_of rdf:type owl:ObjectProperty ;
                          skos:definition "" ;
                          skos:prefLabel "P148i is component of"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P14i_performed
crm:P14i_performed rdf:type owl:ObjectProperty ;
                   owl:inverseOf <https://www.cidoc-crm.org/html/cidoc_crm_v7.1.3.html#P14> ;
                   skos:definition "" ;
                   skos:prefLabel "P14i performed"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P15i_influenced
crm:P15i_influenced rdf:type owl:ObjectProperty ;
                    skos:definition "" ;
                    skos:prefLabel "P15i influenced"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P168i_defines_place
