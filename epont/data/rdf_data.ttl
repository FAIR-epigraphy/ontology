###  http://www.cidoc-crm.org/extensions/crmtex/TXP10_deciphered_text
crmtex:TXP10_deciphered_text rdf:type owl:ObjectProperty ;
                             owl:inverseOf crmtex:TXP10i_was_deciphered_by ;
                             rdfs:domain epont:Autopsy ;
                             rdfs:range crm:E24_Physical_Human-Made_Thing ,
                                        epont:Inscribed_Text ;
                             rdfs:comment "Inverse: was deciphered by"@en ;
                             skos:definition ""@en ;
                             skos:prefLabel "TXP10 deciphered text"@en ;
                             skos:scopeNote """This property associates an instance of TX5 Text Recognition with an instance of E24 Physical Human-Made Thing carrying a glyph or a sequence of glyphs that was recognized in the respective activity of text recognition. Typically, the associated instance of E24 Physical Human-Made Thing is more specifically an instance of TX1 Written Text [epont: Inscribed Text], however, a text may also be recognized from a mechanical copy, a photograph, squeeze or other form of material copy of a written original, which would not by itself constitute an instance of TX1 Written Text. In the latter case, the material copy should be associated with the original written text using the property ‘P130 shows features’.

If the text was actually recognized only from a digital representation, this property should not be used, rather the property TXP13 deciphered via the representation should be used instead."""^^xsd:string .


###  http://www.cidoc-crm.org/extensions/crmtex/TXP10i_was_deciphered_by
crmtex:TXP10i_was_deciphered_by rdf:type owl:ObjectProperty ;
                                skos:definition "" ;
                                skos:prefLabel "TXP10i was deciphered by"@en .


###  http://www.cidoc-crm.org/extensions/crmtex/TXP11_transcribed
crmtex:TXP11_transcribed rdf:type owl:ObjectProperty ;
                         owl:inverseOf crmtex:TXP11i_was_transcribed_by ;
                         rdfs:domain epont:Transcribing ;
                         rdfs:range crmtex:TX12_Grapheme_Sequence ;
                         rdfs:comment "Inverse: was transcribed by"@en ;
                         skos:definition ""@en ;
                         skos:prefLabel "TXP11 transcribed"@en ;
                         skos:scopeNote "This property describes the relation between an activity of TX6 Transliteration and the identified sequence of graphemes (TX12) represented in an instance of TX1 Written Text [Inscribed Text]"^^xsd:string .


###  http://www.cidoc-crm.org/extensions/crmtex/TXP11i_was_transcribed_by
crmtex:TXP11i_was_transcribed_by rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf crm:P12_occurred_in_the_presence_of ;
                                 skos:definition "" ;
                                 skos:prefLabel "was transcribed by"@en .


###  http://www.cidoc-crm.org/extensions/crmtex/TXP13_deciphered_via_the_representation
crmtex:TXP13_deciphered_via_the_representation rdf:type owl:ObjectProperty ;
                                               rdfs:domain crmtex:TX5_Text_Recognition ;
                                               rdfs:range <http://cidoc-crm.org/cidoc-crm/7.1.3/E36_Visual_Item> ;
                                               rdfs:comment "Inverse: was representation used for deciphering"@en ;
                                               skos:definition ""@en ;
                                               skos:prefLabel "TXP13 deciphered via the representation"@en ;
                                               skos:scopeNote """This property associates an instance of TX5 Text Recognition with an instance of E36 Visual Item, capturing the optical impression of an instance of TX1 Written Text [Inscribed Text] by some mechanical method, that was used for recognizing the text without access to the original text and without an explicitly documented material copy or electronic display device that was used for the process.

If the text was actually recognized from an autoptic recognition or from a material reproduction, this property may not be used but the property “TXP10 deciphered text (was deciphered by)” should be used instead.

This property should also not be used, if the recognition of the text was actually carried out from the original text or a material copy of it together with an auxiliary instance of E36 Visual Item. In this case, the use of the auxiliary material should be documented with the more general property P16 used specific object [a subproperty of P15 influenced by]"""^^xsd:string .


###  http://www.cidoc-crm.org/extensions/crmtex/TXP14_used_copy_or_representation_of
crmtex:TXP14_used_copy_or_representation_of rdf:type owl:ObjectProperty ;
                                            owl:inverseOf crmtex:TXP14i_was_deciphered_via_copy_or_representation ;
                                            rdfs:domain crmtex:TX5_Text_Recognition ;
                                            rdfs:range epont:Inscribed_Text ;
                                            rdfs:comment "Inverse: was deciphered via copy or representation"@en ;
                                            skos:definition ""@en ;
                                            skos:prefLabel "TXP14 used copy or representation of"@en ;
                                            skos:scopeNote """This property associates an instance of TX5 Text Recognition, carried out only via copies or representations of a text, with the original instance of TX1 Written Text that was represented on the used copies or digital surrogates.

This property is to be used only for non-autoptic recognition. If this particular recognition of the text was actually carried out from the original text, the property TXP10 deciphered text should be used for associating the instance of TX5 Text Recognition with the original instance of TX1 Written Text.

If some form of material copy of the written text was used for the text recognition, then this material copy should be associated with the original written text using the property ‘P130 shows features of’."""^^xsd:string .


###  http://www.cidoc-crm.org/extensions/crmtex/TXP14i_was_deciphered_via_copy_or_representation
crmtex:TXP14i_was_deciphered_via_copy_or_representation rdf:type owl:ObjectProperty ;
                                                        skos:definition "" ;
                                                        skos:prefLabel "TXP14i was representation used for deciphering"@en .


###  http://www.cidoc-crm.org/extensions/crmtex/TXP15_recorded_correspondence
crmtex:TXP15_recorded_correspondence rdf:type owl:ObjectProperty ;
                                     owl:inverseOf crmtex:TXP15i_was_recorded_by ;
                                     rdfs:domain epont:Autopsy ;
                                     rdfs:range crmtex:TX12_Grapheme_Sequence ;
                                     rdfs:comment "Inverse: was recorded by"@en ;
                                     skos:definition ""@en ;
                                     skos:prefLabel "TXP15 recorded correspondence"@en ;
                                     skos:scopeNote "This property associates an instance of TX5 Text Recognition with an instance of TX12 Grapheme Sequence that was created by this activity of text recognition for recording and representing as faithfully as possible the exact value of each sign on the physical material of the recognized instance of TX1 Written Text [Inscribed Text]."^^xsd:string .


