###  http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TXP16_employs_script
<http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TXP16_employs_script> rdf:type owl:ObjectProperty ;
                                                                               rdfs:domain <http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TX3_Writing_System> ;
                                                                               rdfs:range <http://www.cidoc-crm.org/extensions/crmtex/versions/2.0/TX13_Script> ;
